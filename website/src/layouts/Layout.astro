---
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Decision Authority Layer (DAL) Context Website" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | DAL</title>
		<style is:global>
			:root {
				--bg-color: #ffffff;
				--text-color: #111111;
				--accent-color: #000000;
				--border-color: #dddddd;
			}
			body {
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
				background-color: var(--bg-color);
				color: var(--text-color);
				margin: 0;
				padding: 0;
				line-height: 1.6;
			}
			header {
				border-bottom: 1px solid var(--border-color);
				padding: 1rem 2rem;
			}
			nav {
				display: flex;
				gap: 1.5rem;
			}
			nav a {
				color: var(--text-color);
				text-decoration: none;
				font-weight: 500;
			}
			nav a:hover {
				text-decoration: underline;
			}
			.authority-banner {
				background-color: #f8f8f8;
				border-bottom: 1px solid var(--border-color);
				padding: 0.75rem 2rem;
				font-size: 0.9rem;
				text-align: center;
			}
			.authority-banner a {
				color: var(--accent-color);
				font-weight: 600;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 3rem 2rem;
			}
			footer {
				margin-top: 4rem;
				padding: 2rem;
				border-top: 1px solid var(--border-color);
				text-align: center;
				font-size: 0.9rem;
				color: #666;
			}
			h1, h2, h3 {
				color: var(--accent-color);
				line-height: 1.2;
			}
			h1 { font-size: 2.5rem; margin-bottom: 1rem; }
			h2 { font-size: 1.75rem; margin-top: 2rem; margin-bottom: 1rem; }
			a { color: var(--accent-color); }
			ul { padding-left: 1.5rem; }
			li { margin-bottom: 0.5rem; }
		</style>
	</head>
	<body>
		<div class="authority-banner">
			Context only. The authoritative DAL specification is published on GitHub. <a href="https://blockchaination.github.io/decision-authority-layer/spec/">Read the Spec</a>
		</div>
		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/scope">Scope</a>
				<a href="/context">Context</a>
				<a href="/writing">Writing</a>
				<a href="/contribute">Contribute</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			Decision Authority Layer (DAL) v0.1<br>
			Canonical specification hosted on GitHub<br>
			This website provides context only
		</footer>
	</body>
</html>
